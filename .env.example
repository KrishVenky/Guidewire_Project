# Copy this file to .env and fill in your real values
# DO NOT put real credentials in this file — it gets committed to git

# Database — get the URI from Supabase Dashboard > Project Settings > Database > Connection string > URI
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres

# LLM — optional. If not set, app uses Hinglish template fallback automatically.
# Get free key at console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# AQI — free token at aqicn.org/api
WAQI_API_TOKEN=

# Razorpay — any string works for mock mode in Phase 2
RAZORPAY_KEY_ID=mock_key
RAZORPAY_KEY_SECRET=mock_secret

# App
MOCK_MODE=true
SECRET_KEY=change_this_in_production
JWT_EXP_MINUTES=480
OTP_EXP_MINUTES=5
ADMIN_PIN=admin123
AUTH_DEBUG_RETURN_OTP=true
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
